# MAX Bot
MAX_BOT_TOKEN=your_max_bot_token
WEBHOOK_URL=https://your-domain.com/api/webhook

# Telegram Bot
TG_BOT_TOKEN=your_telegram_bot_token
TG_WEBHOOK_URL=https://your-domain.com/api/tg-webhook

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://hackathon:password@localhost:5432/hackathon

# GigaChat (Sber AI)
CLIENT_ID=your_gigachat_client_id
CLIENT_SECRET=your_gigachat_client_secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Mail API
MAIL_API_URL=https://your-domain.com/api/mail/send
MAIL_API_KEY=your_mail_api_key

# Auth
JWT_SECRET=your_jwt_secret
